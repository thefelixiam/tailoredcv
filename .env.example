# Copy to .env for local overrides. Never commit .env itself.
# Public origin used by the PDF renderer (fail-closed in production).
# APP_URL=http://localhost:3000
# SQLite directory (defaults to ./data).
# CV_TAILOR_DATA_DIR=./data
# Email of the user shown on the public /portfolio page (defaults to earliest user).
# PORTFOLIO_USER_EMAIL=you@example.com
# Optional Ollama-assisted job analysis (deterministic parser is the default
# and the automatic fallback). Requires a local Ollama server with a model.
# OLLAMA_ENABLED=true
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1
# Demo password for `npm run seed` (randomly generated and printed if unset).
# SEED_PASSWORD=change-me
